<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^_migration(/|$) - [F,L]
RewriteRule ^v2/?$ https://govisibi.ai/ [R=301,L,NE]
RewriteRule ^v2/(.*)$ https://govisibi.ai/$1 [R=301,L,NE]
RewriteRule ^seo/?$ https://govisibi.ai/seo-services/ [R=301,L,NE]
RewriteRule ^how-we-work/?$ https://govisibi.ai/about/ [R=301,L,NE]
RewriteRule ^tool/?$ https://govisibi.ai/tools/ [R=301,L,NE]
RewriteRule ^terms-of-use/?$ https://govisibi.ai/terms/ [R=301,L,NE]
RewriteRule ^privacy-policy-2/?$ https://govisibi.ai/privacy/ [R=301,L,NE]
RewriteRule ^2025/11/17/chatgpt-brand-discovery/?$ https://govisibi.ai/insights/how-to-get-recommended-by-chatgpt/ [R=301,L,NE]
RewriteRule ^2025/12/01/geo-playbook-2026/?$ https://govisibi.ai/insights/what-is-geo/ [R=301,L,NE]
RewriteRule ^2025/12/01/small-business-ai-visibility-guide/?$ https://govisibi.ai/insights/how-to-measure-ai-visibility/ [R=301,L,NE]
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
